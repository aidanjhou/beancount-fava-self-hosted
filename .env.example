# All configurations have production-ready defaults in docker-compose.yaml.
# You can uncomment any variable below to override its default value.

# Host port mapping (default: 1818)
# FAVA_HOST_PORT=1818

# Container internal host binding (default: 0.0.0.0)
# FAVA_HOST=0.0.0.0

# Container internal listening port (default: 8000)
# FAVA_PORT=8000

# Container internal ledger file path (default: /data/main.beancount)
# BEANCOUNT_FILE=/data/main.beancount
